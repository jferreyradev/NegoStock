# ==============================================================================
# NEGOSTOCK - CONFIGURACIÓN DE CONEXIÓN A SUPABASE (POSTGRESQL MULTI-ENTORNO)
# ==============================================================================
# El frontend unificado permite conectar a Producción o Sandbox (Desarrollo).
# Si el usuario es SUPERADMIN (PIN 9999), puede alternar en caliente entre ambos.

# 1. ENTORNO DE PRODUCCIÓN (Ferretería Real)
VITE_PROD_SUPABASE_URL=https://tu-proyecto-prod.supabase.co
VITE_PROD_SUPABASE_ANON_KEY=tu-anon-key-prod-aqui

# 2. ENTORNO DE DESARROLLO (Sandbox / Pruebas)
VITE_DEV_SUPABASE_URL=https://tu-proyecto-dev.supabase.co
VITE_DEV_SUPABASE_ANON_KEY=tu-anon-key-dev-aqui

# 3. FALLBACK ESTÁNDAR (Opcional, por si se usa una sola base)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
